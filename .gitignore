# Never commit a client's ledger export, workpaper, credentials, or generated review pack.
*.csv
!packages/monthly-close-control-plane/examples/*.csv
!packages/monthly-close-control-plane/schemas/*.csv
outputs/
review-notes/

# A review pack goes wherever --output points, not only to outputs/.
# exceptions.csv is caught by *.csv above; these two were not caught by
# anything, so a pack written into the checkout was committable.
close-review-pack.json
close-summary.md
# exceptions.csv is a generated pack file, not a fixture. The two negations
# above re-include every CSV in these directories, so --output pointed at
# either of them left the exception detail committable.
packages/monthly-close-control-plane/examples/exceptions.csv
packages/monthly-close-control-plane/schemas/exceptions.csv
# Staged pack files. One is left behind only if a run is killed mid-write or a
# rollback cannot put a previous file back; it may hold either run's content.
*.partial
.env
.env.*
!.env.example
*.token
*.tokens
*.pem
__pycache__/
.pytest_cache/
.venv/
build/
dist/
*.egg-info/
