# Client data must never enter this repo.
# Anything exported from a real ledger or containing a real entity stays out.
input/
output/
clients/
exports/

# Data-file extensions (ledger exports, workbooks, statements, bank files,
# API dumps)
*.xlsx
*.xlsm
*.xlsb
*.xls
*.xlt
*.xltx
*.xltm
*.csv
*.txt
*.pdf
*.aba
*.ofx
*.qif
*.zip
*.myox
*.myo
*.bak
*.json
*.xml

# Only the reviewed fabricated fixtures are allowed. New data files stay blocked.
!samples/
!samples/sample-payday-super-report.csv
!samples/sample-xero-aged-payables.csv
!samples/sample-xero-aged-receivables.csv
!samples/sample-xero-trial-balance-columns.csv
!samples/sample-xero-trial-balance-excel-export.csv
!samples/sample-xero-trial-balance.csv

# Python bytecode from tools/ and tests/
__pycache__/
*.pyc

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini

# Workflow review scratch, not repo content.
.superpowers/

# Credentials must never be committed.
.env
.env.*
!.env.example
*.token
*.tokens
*.pem
