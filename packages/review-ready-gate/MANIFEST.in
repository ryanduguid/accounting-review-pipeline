include LICENSE
include CITATION.cff
include README.md
include SECURITY.md
include CONTRIBUTING.md
include DISCLAIMER.md
include RELEASING.md
include RELEASE_NOTES.md
include llms.txt
# The component lockfile is the authority for building and releasing this
# distribution alone, so an archive reader can reproduce the locked run.
include uv.lock
# setuptools ships tests/test*.py by default and nothing else under tests/.
# Without the shared helper every one of those modules fails to import, so
# pytest stops at collection and no test runs at all.
recursive-include tests *.py
recursive-include examples *.csv *.json *.yml *.md
recursive-include schemas *.csv *.json
recursive-include evaluation *.md *.json
# Fixture CSVs are named one by one: a recursive rule would also pack any
# ignored CSV left in a working tree, such as a client export.
include evaluation/missing_evidence/packs/absent_prior_trial_balance/bank_rec.csv
include evaluation/missing_evidence/packs/absent_prior_trial_balance/open_items.csv
include evaluation/missing_evidence/packs/absent_prior_trial_balance/trial_balance.csv
include evaluation/missing_evidence/packs/no_bank_reconciliation/open_items.csv
include evaluation/missing_evidence/packs/no_bank_reconciliation/prior_trial_balance.csv
include evaluation/missing_evidence/packs/no_bank_reconciliation/trial_balance.csv
include evaluation/missing_evidence/packs/empty_bank_reconciliation/bank_rec.csv
include evaluation/missing_evidence/packs/empty_bank_reconciliation/open_items.csv
include evaluation/missing_evidence/packs/empty_bank_reconciliation/prior_trial_balance.csv
include evaluation/missing_evidence/packs/empty_bank_reconciliation/trial_balance.csv
include evaluation/missing_evidence/packs/wrong_period/bank_rec.csv
include evaluation/missing_evidence/packs/wrong_period/open_items.csv
include evaluation/missing_evidence/packs/wrong_period/prior_trial_balance.csv
include evaluation/missing_evidence/packs/wrong_period/trial_balance.csv
