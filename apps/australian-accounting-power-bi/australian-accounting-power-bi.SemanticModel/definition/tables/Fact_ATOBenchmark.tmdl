table Fact_ATOBenchmark
	lineageTag: a1b2c3d4-ato-0009-8899-aabbccddeeff

	/// Sample reference value for the selected entity and annual turnover band; blank when unavailable.
	measure 'ATO Benchmark Gross Profit %' =
			VAR Band = [Benchmark Turnover Band]
			RETURN
			    IF(
			        NOT ISBLANK(Band),
			        CALCULATE(
			            SELECTEDVALUE(Fact_ATOBenchmark[GrossProfitPct_Avg]),
			            TREATAS(VALUES(Dim_Entity[ANZSIC_Code]), Fact_ATOBenchmark[ANZSIC_Code]),
			            Fact_ATOBenchmark[TurnoverRange] = Band
			        ) / 100
			    )
		formatString: 0.0%
		lineageTag: ato-meas-0001

	/// Signed percentage-point distance outside the selected gross profit range; zero within its inclusive bounds.
	measure 'Gross Profit Variance to Benchmark %' =
			VAR Low = [Benchmark Gross Profit Lower %]
			VAR High = [Benchmark Gross Profit Upper %]
			VAR Actual = [Gross Profit Margin %]
			RETURN
			    IF(
			        NOT ISBLANK(Low) && NOT ISBLANK(High) && NOT ISBLANK(Actual) && [Revenue] > 0,
			        SWITCH(TRUE(), Actual < Low, Actual - Low, Actual > High, Actual - High, 0)
			    )
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: ato-meas-0002

	/// Actual operating expenses divided by total trading revenue.
	measure 'Actual Total Expense Ratio %' = DIVIDE([Operating Expenses], [Revenue], 0)
		formatString: 0.0%
		lineageTag: ato-meas-0003

	/// Sample reference value for the selected entity and annual turnover band; blank when unavailable.
	measure 'ATO Benchmark Expense Ratio %' =
			VAR Band = [Benchmark Turnover Band]
			RETURN
			    IF(
			        NOT ISBLANK(Band),
			        CALCULATE(
			            SELECTEDVALUE(Fact_ATOBenchmark[TotalExpensesPct_Avg]),
			            TREATAS(VALUES(Dim_Entity[ANZSIC_Code]), Fact_ATOBenchmark[ANZSIC_Code]),
			            Fact_ATOBenchmark[TurnoverRange] = Band
			        ) / 100
			    )
		formatString: 0.0%
		lineageTag: ato-meas-0004

	/// Rent and property occupancy expense as a proportion of total revenue.
	measure 'Actual Rent to Revenue %' =
			DIVIDE(
				CALCULATE(
					SUM(Fact_GeneralLedger[Debit]) - SUM(Fact_GeneralLedger[Credit]),
					Dim_Account[AccountCode] = "820"
				),
				[Revenue],
				0
			)
		formatString: 0.0%
		lineageTag: ato-meas-0005

	/// Sample reference value for the selected entity and annual turnover band; blank when unavailable.
	measure 'ATO Benchmark Rent %' =
			VAR Band = [Benchmark Turnover Band]
			RETURN
			    IF(
			        NOT ISBLANK(Band),
			        CALCULATE(
			            SELECTEDVALUE(Fact_ATOBenchmark[RentPct_Avg]),
			            TREATAS(VALUES(Dim_Entity[ANZSIC_Code]), Fact_ATOBenchmark[ANZSIC_Code]),
			            Fact_ATOBenchmark[TurnoverRange] = Band
			        ) / 100
			    )
		formatString: 0.0%
		lineageTag: ato-meas-0006

	/// Motor vehicle running costs as a proportion of total revenue.
	measure 'Actual Motor Vehicle %' =
			DIVIDE(
				CALCULATE(
					SUM(Fact_GeneralLedger[Debit]) - SUM(Fact_GeneralLedger[Credit]),
					Dim_Account[AccountCode] = "810"
				),
				[Revenue],
				0
			)
		formatString: 0.0%
		lineageTag: ato-meas-0007

	/// Sample reference value for the selected entity and annual turnover band; blank when unavailable.
	measure 'ATO Benchmark Motor Vehicle %' =
			VAR Band = [Benchmark Turnover Band]
			RETURN
			    IF(
			        NOT ISBLANK(Band),
			        CALCULATE(
			            SELECTEDVALUE(Fact_ATOBenchmark[MotorVehiclePct_Avg]),
			            TREATAS(VALUES(Dim_Entity[ANZSIC_Code]), Fact_ATOBenchmark[ANZSIC_Code]),
			            Fact_ATOBenchmark[TurnoverRange] = Band
			        ) / 100
			    )
		formatString: 0.0%
		lineageTag: ato-meas-0008

	/// Salaries and superannuation expense divided by total revenue.
	measure 'Actual Labour Ratio %' =
			DIVIDE(
				CALCULATE(
					SUM(Fact_GeneralLedger[Debit]) - SUM(Fact_GeneralLedger[Credit]),
					Dim_Account[AccountCode] IN {"800", "805"}
				),
				[Revenue],
				0
			)
		formatString: 0.0%
		lineageTag: ato-meas-0009

	/// Sample reference value for the selected entity and annual turnover band; blank when unavailable.
	measure 'ATO Benchmark Labour %' =
			VAR Band = [Benchmark Turnover Band]
			RETURN
			    IF(
			        NOT ISBLANK(Band),
			        CALCULATE(
			            SELECTEDVALUE(Fact_ATOBenchmark[LabourPct_Avg]),
			            TREATAS(VALUES(Dim_Entity[ANZSIC_Code]), Fact_ATOBenchmark[ANZSIC_Code]),
			            Fact_ATOBenchmark[TurnoverRange] = Band
			        ) / 100
			    )
		formatString: 0.0%
		lineageTag: ato-meas-0010

	/// Gross profit comparison only. The legacy measure name is retained for report bindings; this is not an audit-risk assessment.
	measure 'ATO Compliance Risk Profile' =
			VAR Difference = [Gross Profit Variance to Benchmark %]
			RETURN
			    SWITCH(
			        TRUE(),
			        NOT HASONEVALUE(Dim_Entity[EntityID]) || NOT HASONEVALUE(Dim_Date[FinancialYearNumber]), "Select one entity and financial year",
			        ISBLANK([Benchmark Annual Turnover]) || [Benchmark Annual Turnover] <= 0, "No turnover",
			        ISBLANK([Benchmark Turnover Band]), "No matching benchmark",
			        ISBLANK(Difference), "No margin data",
			        Difference < 0, "Below gross profit range",
			        Difference > 0, "Above gross profit range",
			        "Within gross profit range"
			    )
		lineageTag: ato-meas-0011

	/// Full financial-year revenue for one entity; account and subperiod filters cannot change the band.
	measure 'Benchmark Annual Turnover' =
			VAR FiscalYear = SELECTEDVALUE(Dim_Date[FinancialYearNumber])
			RETURN
				IF(
					HASONEVALUE(Dim_Entity[EntityID]) && NOT ISBLANK(FiscalYear),
					CALCULATE(
						[Revenue],
						REMOVEFILTERS(Dim_Date),
						REMOVEFILTERS(Dim_Account),
						Dim_Date[FinancialYearNumber] = FiscalYear
					)
				)
		formatString: $#,##0.00;($#,##0.00);$0.00
		lineageTag: ato-meas-0012

	/// Exactly one sample industry band, with turnover greater than its lower bound and at most its upper bound.
	measure 'Benchmark Turnover Band' =
			VAR Turnover = [Benchmark Annual Turnover]
			VAR Industry = SELECTEDVALUE(Dim_Entity[ANZSIC_Code])
			VAR Bands = FILTER(
				ALL(Fact_ATOBenchmark),
				Fact_ATOBenchmark[ANZSIC_Code] = Industry
					&& Turnover > Fact_ATOBenchmark[TurnoverLowerBound]
					&& Turnover <= Fact_ATOBenchmark[TurnoverUpperBound]
			)
			RETURN
				IF(
					Turnover > 0 && NOT ISBLANK(Industry) && COUNTROWS(Bands) = 1,
					MAXX(Bands, Fact_ATOBenchmark[TurnoverRange])
				)
		lineageTag: ato-meas-0013

	/// Lower inclusive gross profit bound for the selected sample band.
	measure 'Benchmark Gross Profit Lower %' =
			VAR Band = [Benchmark Turnover Band]
			RETURN
				IF(
					NOT ISBLANK(Band),
					CALCULATE(
						SELECTEDVALUE(Fact_ATOBenchmark[GrossProfitPct_Low]),
						TREATAS(VALUES(Dim_Entity[ANZSIC_Code]), Fact_ATOBenchmark[ANZSIC_Code]),
						Fact_ATOBenchmark[TurnoverRange] = Band
					) / 100
				)
		formatString: 0.0%
		lineageTag: ato-meas-0014

	/// Upper inclusive gross profit bound for the selected sample band.
	measure 'Benchmark Gross Profit Upper %' =
			VAR Band = [Benchmark Turnover Band]
			RETURN
				IF(
					NOT ISBLANK(Band),
					CALCULATE(
						SELECTEDVALUE(Fact_ATOBenchmark[GrossProfitPct_High]),
						TREATAS(VALUES(Dim_Entity[ANZSIC_Code]), Fact_ATOBenchmark[ANZSIC_Code]),
						Fact_ATOBenchmark[TurnoverRange] = Band
					) / 100
				)
		formatString: 0.0%
		lineageTag: ato-meas-0015

	column ANZSIC_Code
		dataType: string
		lineageTag: ato-col-0001
		summarizeBy: none
		sourceColumn: ANZSIC_Code

	column TurnoverRange
		dataType: string
		lineageTag: ato-col-0002
		summarizeBy: none
		sourceColumn: TurnoverRange

	column GrossProfitPct_Low
		dataType: double
		formatString: 0.0
		lineageTag: ato-col-0003
		summarizeBy: average
		sourceColumn: GrossProfitPct_Low

	column GrossProfitPct_Avg
		dataType: double
		formatString: 0.0
		lineageTag: ato-col-0004
		summarizeBy: average
		sourceColumn: GrossProfitPct_Avg

	column GrossProfitPct_High
		dataType: double
		formatString: 0.0
		lineageTag: ato-col-0005
		summarizeBy: average
		sourceColumn: GrossProfitPct_High

	column TotalExpensesPct_Avg
		dataType: double
		formatString: 0.0
		lineageTag: ato-col-0006
		summarizeBy: average
		sourceColumn: TotalExpensesPct_Avg

	column RentPct_Avg
		dataType: double
		formatString: 0.0
		lineageTag: ato-col-0007
		summarizeBy: average
		sourceColumn: RentPct_Avg

	column MotorVehiclePct_Avg
		dataType: double
		formatString: 0.0
		lineageTag: ato-col-0008
		summarizeBy: average
		sourceColumn: MotorVehiclePct_Avg

	column LabourPct_Avg
		dataType: double
		formatString: 0.0
		lineageTag: ato-col-0009
		summarizeBy: average
		sourceColumn: LabourPct_Avg

	column TurnoverLowerBound
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: ato-col-0010
		summarizeBy: none
		sourceColumn: TurnoverLowerBound

	column TurnoverUpperBound
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: ato-col-0011
		summarizeBy: none
		sourceColumn: TurnoverUpperBound

	partition Fact_ATOBenchmark = m
		mode: import
		source =
			let
				Source = Source_Fact_ATOBenchmark
			in
				Source
