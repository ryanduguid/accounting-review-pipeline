table Review_Exception
	lineageTag: 2301fe2f-869a-4cb8-bf1d-0415dab13b7c

	/// One only when a single finding is explicitly selected by account or exception identity.
	measure 'Finding selection present' = IF(HASONEVALUE(Review_Exception[ExceptionKey]) && (ISFILTERED(Review_Exception[Account]) || ISFILTERED(Review_Exception[ExceptionKey])), 1, 0)
		formatString: 0
		displayFolder: Review details

	/// The complete source action for one selected finding; prompts for selection otherwise.
	measure 'Finding Action' = IF([Finding selection present] = 1, SELECTEDVALUE(Review_Exception[Action]), "Select a single finding to see its full details.")
		displayFolder: Review details

	/// The complete source question for one selected finding; blank otherwise.
	measure 'Finding Question' = IF([Finding selection present] = 1, SELECTEDVALUE(Review_Exception[Question]), BLANK())
		displayFolder: Review details

	/// The complete source reason for one selected finding; blank otherwise.
	measure 'Finding Reason' = IF([Finding selection present] = 1, SELECTEDVALUE(Review_Exception[Reason]), BLANK())
		displayFolder: Review details

	/// The complete source evidence request for one selected finding; blank otherwise.
	measure 'Finding Evidence requested' = IF([Finding selection present] = 1, SELECTEDVALUE(Review_Exception[EvidenceRequested]), BLANK())
		displayFolder: Review details

	/// The source evidence state for one selected finding; blank otherwise.
	measure 'Finding Evidence state' = IF([Finding selection present] = 1, SELECTEDVALUE(Review_Exception[EvidenceState]), BLANK())
		displayFolder: Review details

