		summarizeBy: none
		sourceColumn: Description

	column IntercompanyEntityID
		dataType: string
		lineageTag: gl-col-0010
		summarizeBy: none
		sourceColumn: IntercompanyEntityID

	column IsIntercompany
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: gl-col-0011
		summarizeBy: none
		sourceColumn: IsIntercompany

	partition Fact_GeneralLedger = m
		mode: import
		source =
			let
				Source = Source_Fact_GeneralLedger
			in
				Source
