		formatString: $#,##0.00
		lineageTag: stp-col-0015
		summarizeBy: sum
		sourceColumn: SGC_Shortfall

	column GIC_NominalInterest
		dataType: decimal
		formatString: $#,##0.00
		lineageTag: stp-col-0016
		summarizeBy: sum
		sourceColumn: GIC_NominalInterest

	column PaymentRegime
		dataType: string
		summarizeBy: none
		sourceColumn: PaymentRegime

	column EstimateBasis
		dataType: string
		summarizeBy: none
		sourceColumn: EstimateBasis

	/// Human-readable receipt status derived from the validated source code.
	column ReceiptStatus
		dataType: string
		summarizeBy: none
		sourceColumn: ReceiptStatus

	partition Fact_PayrollSuper = m
		mode: import
		source =
			let
				Source = Source_Fact_PayrollSuper,
				WithReceiptLabel = Table.AddColumn(Source, "ReceiptStatus", each if [ComplianceStatus] = "ON_TIME" then "On time" else "Late", type text)
			in
				WithReceiptLabel
