		formatString: $#,##0.00
		lineageTag: stp-col-0008
		summarizeBy: sum
		sourceColumn: SuperLiability_CodeL

	column SuperFundUSI
		dataType: string
		lineageTag: stp-col-0009
		summarizeBy: none
		sourceColumn: SuperFundUSI

	column SuperFundName
		dataType: string
		lineageTag: stp-col-0010
		summarizeBy: none
		sourceColumn: SuperFundName

	column RemittanceDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: stp-col-0011
