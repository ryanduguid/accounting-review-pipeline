      "name": "CY24SU10",
      "reportVersionAtImport": {
        "visual": "2.9.0",
        "report": "3.3.0",
        "page": "2.1.0"
      },
      "type": "SharedResources"
    },
    "customTheme": {
      "name": "AccountingReview.json",
      "type": "RegisteredResources",
      "reportVersionAtImport": {
